# 复制为 .env 后使用：cp .env.example .env
#
# VITE_API_TARGET 必须与后端 application.yaml 的 server.port（SERVER_PORT）一致，
# 否则 Vite 代理会打空。默认 8081，因为 8080 常被其他服务占用。

# 与后端 application.yaml 的 server.port（SERVER_PORT）一致
VITE_API_TARGET=http://127.0.0.1:8081

# Vite dev server 端口；须与后端 CORS 白名单里的 FRONTEND_PORT 一致
FRONTEND_PORT=5173