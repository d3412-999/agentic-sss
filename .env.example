# Local development configuration sample.
#   cp .env.example .env        (Windows: copy .env.example .env)
#
# Used by docker compose (container credentials) and by you when starting the
# services by hand. Spring Boot does NOT read .env: it reads the environment
# variables below and otherwise falls back to the defaults in application.yaml.
#
# These are weak local-development defaults. Replace every password and
# JWT_SECRET before any real deployment.

# ---- MySQL ----
DB_ROOT_PASSWORD=change-me
DB_NAME=sss
DB_USER=sss
DB_PASSWORD=change-me
DB_HOST=127.0.0.1
DB_PORT=3306
MYSQL_PORT=3306

# ---- Redis (required: login rate limit, idempotency, refresh tokens) ----
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# ---- Ports ----
# Changing SERVER_PORT requires the same change in vue/.env (VITE_API_TARGET)
SERVER_PORT=8084
AI_PORT=8000
FRONTEND_PORT=5173

# ---- Backend -> AI service ----
AI_BASE_URL=http://127.0.0.1:8000
# Must match AI_INTERNAL_TOKEN in langchain_service/.env
AI_INTERNAL_TOKEN=change-me

# ---- AI 服务：真实大模型（必填）----
# 任何 OpenAI 兼容接口均可，默认 DeepSeek；不配置则 AI 评审/出题/评分返回 503
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_API_KEY=

# ---- File storage (local disk) ----
STORAGE_DIR=./data/objects

# ---- Student accounts (teacher-side roster import) ----
# Student initial password is fixed to the student number; no default-password config.

# ---- JWT secret (>= 32 bytes) ----
JWT_SECRET=change-me-change-me-change-me-change-me

# ---- Reverse proxy trust (client IP / login rate limit / audit log) ----
# Empty default: never trust X-Forwarded-For, the direct peer address is used.
# Only behind your own reverse proxy, list its IPs / IPv4 CIDRs (comma separated).
# TRUSTED_PROXIES=

# ---- HTTPS reverse proxy (avoid same-origin CORS 403 after TLS termination) ----
# Backend must honour X-Forwarded-Proto/Host/Port, and allow the public origin.
SERVER_FORWARD_HEADERS_STRATEGY=framework
# Comma-separated Origin patterns; localhost defaults still apply when empty.
SSS_CORS_ALLOWED_ORIGINS=https://your-domain.example
