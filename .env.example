# Local development configuration sample.
#   cp .env.example .env        (Windows: copy .env.example .env)
#
# Used by docker compose (container credentials) and by you when starting the
# services by hand. Spring Boot does NOT read .env: it reads the environment
# variables below and otherwise falls back to the defaults in application.yaml.
#
# These are weak local-development defaults. Replace every password and
# JWT_SECRET before any real deployment.

# ---- MySQL ----
DB_ROOT_PASSWORD=123456
DB_NAME=sss
DB_USER=sss
DB_PASSWORD=sss123456
DB_HOST=127.0.0.1
DB_PORT=3306
MYSQL_PORT=3306

# ---- Redis (required: login rate limit, idempotency, refresh tokens) ----
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=123456

# ---- Ports ----
# Changing SERVER_PORT requires the same change in vue/.env (VITE_API_TARGET)
SERVER_PORT=8081
AI_PORT=8000
FRONTEND_PORT=5173

# ---- Backend -> AI service ----
AI_BASE_URL=http://127.0.0.1:8000
# Must match AI_INTERNAL_TOKEN in langchain_service/.env
AI_INTERNAL_TOKEN=change-me

# ---- File storage (local disk) ----
STORAGE_DIR=./data/objects

# ---- JWT secret (>= 32 bytes) ----
JWT_SECRET=change-me-change-me-change-me-change-me
