# ---- Secrets: never commit real credentials ----
.env
*.env
!.env.example
!**/.env.example

# ---- Java / Gradle ----
.gradle/
build/
out/
*.class
*.jar
*.war
# Gradle Wrapper 的 jar 必须入库，否则别人 clone 后没有 wrapper 可用
!gradle/wrapper/gradle-wrapper.jar
!**/gradle/wrapper/gradle-wrapper.jar

# ---- Python ----
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ---- Node / Vite ----
node_modules/
dist/
.vite/
*.tmpdir/
npm-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---- Runtime data ----
data/
logs/
*.log
*.rdb

# ---- IDE: share only project-wide IDEA settings ----
.idea/*
!.idea/misc.xml
!.idea/encodings.xml
!.idea/gradle.xml
!.idea/runConfigurations/
*.iml
*.iws
*.ipr
.vscode/*
!.vscode/extensions.json

# ---- OS ----
Thumbs.db
.DS_Store
