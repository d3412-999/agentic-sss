# ---- Secrets: never commit real credentials ----
.env
*.env
!.env.example
!**/.env.example

# ---- Java / Gradle ----
.gradle/
build/
out/
*.class
*.jar
*.war
# Gradle Wrapper 的 jar 必须入库，否则别人 clone 后没有 wrapper 可用
!gradle/wrapper/gradle-wrapper.jar
!**/gradle/wrapper/gradle-wrapper.jar

# ---- Python ----
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ---- Node / Vite ----
node_modules/
dist/
.vite/
*.tmpdir/
npm-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---- Runtime data ----
data/
logs/
*.log
*.rdb

# ---- IDE: 不入库 ----
# clone 后直接用 IDEA 打开仓库根目录、按 backend / vue / langchain_service 三个模块
# 自己建运行配置即可；IDE 配置带有本机路径与 SDK 名，提交上去只会污染他人环境。
.idea/
*.iml
*.iws
*.ipr
.vscode/
!.vscode/extensions.json

# ---- OS ----
Thumbs.db
.DS_Store
