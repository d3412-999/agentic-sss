# 复制为 .env 后按需修改
# 变量名与仓库根目录 .env.example 对齐：AI_HOST / AI_PORT / AI_INTERNAL_TOKEN

AI_HOST=0.0.0.0
AI_PORT=8000
LOG_LEVEL=INFO

# Java 后端调用时放在 X-Internal-Token 请求头里，必须与后端 AI_INTERNAL_TOKEN 一致
AI_INTERNAL_TOKEN=change-me

# 大模型：OpenAI 兼容接口（必填）。未配置 LLM_API_KEY 时 AI 评审/出题/评分返回 503。
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=1

# LightRAG（可选）：开启后优先使用 LightRAG 检索，失败自动回退本地检索
LIGHTRAG_ENABLED=false
LIGHTRAG_BASE_URL=http://127.0.0.1:9621
LIGHTRAG_API_KEY=
LIGHTRAG_QUERY_MODE=mix

# 检索与文本长度限制
RAG_TOP_K=5
RAG_MAX_CODE_CHARS=30000
RAG_MAX_SECTION_CHARS=8000

# 语音转写（sherpa-onnx 中文 paraformer）：模型目录至少包含 tokens.txt 与 *.onnx
ASR_MODEL_DIR=./models/sherpa-onnx-paraformer-zh
ASR_LANGUAGE=zh-CN

# 人脸在场检测（OpenCV haarcascade 内置模型，无需额外文件）
FACE_MIN_SIZE=60