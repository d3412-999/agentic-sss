# 复制为 .env 后使用：cp .env.example .env
# 变量名与默认值已与仓库根目录 .env.example 对齐。

# ---- 服务监听 ----
AI_HOST=127.0.0.1
AI_PORT=8000
LOG_LEVEL=INFO

# ---- 内部令牌 ----
# 必须与后端 application.yaml 的 sss.ai.internal-token（环境变量 AI_INTERNAL_TOKEN）
# 完全相同，否则后端调用 /internal/ai/** 会得到 401。
AI_INTERNAL_TOKEN=change-me

# ---- LLM（当前接口为 501 占位，接入评审/答辩能力后填写）----
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat

# ---- LightRAG（尚未接入）----
LIGHTRAG_BASE_URL=http://127.0.0.1:9621