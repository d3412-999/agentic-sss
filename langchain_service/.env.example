# 复制为 .env 后按需修改
APP_NAME=sss-ai-service
ENVIRONMENT=dev
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# Java 后端调用时放在 X-Internal-Token 请求头里
INTERNAL_TOKEN=change-me

# 大模型：openai 调用 OpenAI 兼容接口；mock 返回确定性数据，便于本地联调
LLM_PROVIDER=openai
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=1

# LightRAG（可选）：开启后优先使用 LightRAG 检索，失败自动回退本地检索
LIGHTRAG_ENABLED=false
LIGHTRAG_BASE_URL=http://127.0.0.1:9621
LIGHTRAG_API_KEY=
LIGHTRAG_QUERY_MODE=mix

# 检索与文本长度限制
RAG_TOP_K=5
RAG_MAX_CODE_CHARS=30000
RAG_MAX_SECTION_CHARS=8000
