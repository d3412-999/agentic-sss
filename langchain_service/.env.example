# 复制为 .env 后按需修改
# 变量名与仓库根目录 .env.example 对齐：AI_HOST / AI_PORT / AI_INTERNAL_TOKEN
AI_HOST=127.0.0.1
AI_PORT=8000
LOG_LEVEL=INFO

# Java 后端调用时放在 X-Internal-Token 请求头里，必须与后端 AI_INTERNAL_TOKEN 一致
AI_INTERNAL_TOKEN=change-me

# 大模型：openai 调用 OpenAI 兼容接口；mock 返回确定性数据，便于本地联调
LLM_PROVIDER=openai
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=1

# LightRAG（可选）：开启后优先使用 LightRAG 检索，失败自动回退本地检索
LIGHTRAG_ENABLED=false
LIGHTRAG_BASE_URL=http://127.0.0.1:9621
LIGHTRAG_API_KEY=
LIGHTRAG_QUERY_MODE=mix

# 检索与文本长度限制
RAG_TOP_K=5
RAG_MAX_CODE_CHARS=30000
RAG_MAX_SECTION_CHARS=8000

# 语音转写（ASR）：mock 离线返回固定文本；sherpa_onnx 需安装 requirements-optional.txt 并准备本地模型
ASR_PROVIDER=mock
ASR_MODEL_DIR=./models/sherpa-onnx-paraformer-zh
ASR_LANGUAGE=zh-CN

# 人脸在场检测：mock 按 base64 长度模拟；opencv 用内置 haarcascade 检测（图像不落盘）
FACE_PROVIDER=mock
FACE_MIN_SIZE=60
FACE_MODEL_DIR=./models/face
